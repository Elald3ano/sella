generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  type      String   // cafeteria, panaderia, jugueria, barberia, lavanderia, otro
  plan      String   @default("trial") // trial, free, basic, pro
  pin       String?  // hash del PIN de 4 dígitos
  email     String?
  address   String?
  ownerName String?  @map("owner_name")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  programs  Program[]
  customers Customer[]
  stamps    Stamp[]
  stampRequests StampRequest[]
  subscription   Subscription?

  @@map("businesses")
}

model Program {
  id         String   @id @default(cuid())
  title      String   // "Los 10 cafes de la casa"
  type       String   @default("stamps") // stamps, points
  target     Int      // 10 = compra 10 llevate 1
  reward     String   // "1 cafe gratis", "15% descuento"
  active     Boolean  @default(true)
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  stamps      Stamp[]
  redemptions Redemption[]
  stampRequests StampRequest[]

  @@map("programs")
}

model Customer {
  id         String   @id @default(cuid())
  name       String
  phone      String
  notes      String?
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lastVisit  DateTime? @map("last_visit")
  createdAt  DateTime @default(now()) @map("created_at")

  stamps      Stamp[]
  redemptions Redemption[]
  stampRequests StampRequest[]

  @@unique([phone, businessId])
  @@map("customers")
}

model Stamp {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  programId  String   @map("program_id")
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("stamps")
}

model Redemption {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  programId  String   @map("program_id")
  program    Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  redeemedAt DateTime @default(now()) @map("redeemed_at")

  @@map("redemptions")
}

model StampRequest {
  id         String   @id @default(cuid())
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessId String   @map("business_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  programId  String?  @map("program_id")
  program    Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  status     String   @default("pending") // pending, approved, rejected
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("stamp_requests")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}

model Subscription {
  id          String   @id @default(cuid())
  businessId  String   @unique @map("business_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan        String   @default("trial") // trial, free, basic, pro
  status      String   @default("active") // active, cancelled
  trialEndsAt DateTime @map("trial_ends_at")
  startedAt   DateTime @default(now()) @map("started_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("subscriptions")
}
